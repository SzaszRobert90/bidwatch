# bidwatch environment template — copy to .env (compose reads it) or export in shell.

# --- object storage / queue (MinIO + ElasticMQ on homelab; unset endpoints on real AWS) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=bidwatchlocal
AWS_SECRET_ACCESS_KEY=bidwatchlocal-secret
BIDWATCH_S3_ENDPOINT=http://localhost:9000
BIDWATCH_SQS_ENDPOINT=http://localhost:9324
BIDWATCH_QUEUE_URL=http://localhost:9324/queue/bidwatch-main
BIDWATCH_DLQ_URL=http://localhost:9324/queue/bidwatch-dlq

# buckets
BIDWATCH_RAW_BUCKET=bidwatch-raw
BIDWATCH_CURATED_BUCKET=bidwatch-curated
BIDWATCH_REPORTS_BUCKET=bidwatch-reports

# --- scraping ---
# live = real Bing via playwright; fixture = committed fixtures (dev/CI)
BIDWATCH_MODE=live
BIDWATCH_SERP_ADAPTER=playwright
BIDWATCH_BROWSER_CHANNEL=chrome
# headless gets no ads; homelab runs headful under xvfb
BIDWATCH_HEADLESS=false
BIDWATCH_PROFILE_DIR=./.profile-bing
BIDWATCH_POLITENESS_MS=1500
BIDWATCH_MAX_LANDINGS=8
# optional comma-separated proxy list, round-robined
BIDWATCH_PROXIES=
# optional curl-impersonate binary for landing fetches (undici fallback)
BIDWATCH_CURL_IMPERSONATE=

# --- apps ---
BIDWATCH_FEEDER_CRON=0 6 * * *

# --- telemetry (optional) ---
# OTLP collector base URL; empty = telemetry fully off (dev/CI default).
# Local checkout with the observability stack: docker compose -f infra/compose.yml up -d otel-lgtm
# then set http://localhost:4318. In prod compose this is prewired to http://otel-lgtm:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
